# The AMO-signed uBlock Origin xpi ships in the application's
# distribution/extensions directory, which installs it enabled into every
# new profile on first run while keeping automatic updates from AMO.
FINAL_TARGET_FILES.distribution.extensions += ["uBlock0@raymondhill.net.xpi"]
