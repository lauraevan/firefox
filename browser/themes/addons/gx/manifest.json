{
  "manifest_version": 2,

  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-gx@mozilla.org"
    }
  },

  "name": "Firefox GX",
  "description": "A dark, high-energy appearance with neon accents.",
  "author": "Mozilla",
  "version": "1.0.0",

  "icons": { "32": "icon.svg" },

  "theme": {
    "images": {
      "additional_backgrounds": ["background-gx.svg"]
    },

    "properties": {
      "additional_backgrounds_alignment": ["right top"],
      "additional_backgrounds_tiling": ["no-repeat"],
      "color_scheme": "dark"
    },

    "colors": {
      "frame": "#0d0d16",
      "frame_inactive": "#0b0b12",
      "toolbar": "#16161f",
      "toolbar_text": "#e8e8f2",
      "toolbar_field": "#1d1d2b",
      "toolbar_field_text": "#e8e8f2",
      "toolbar_field_focus": "#232334",
      "toolbar_field_text_focus": "#ffffff",
      "toolbar_field_border": "transparent",
      "toolbar_field_border_focus": "#ff2e63",
      "toolbar_field_highlight": "rgba(255, 46, 99, 0.32)",
      "toolbar_top_separator": "transparent",
      "toolbar_bottom_separator": "#0a0a10",
      "tab_text": "#ffffff",
      "tab_background_text": "#a3a3b8",
      "tab_line": "#ff2e63",
      "tab_loading": "#ff2e63",
      "bookmark_text": "#e8e8f2",
      "icons": "#c2c2d6",
      "icons_attention": "#ff2e63",
      "button_background_hover": "rgba(255, 255, 255, 0.08)",
      "button_background_active": "rgba(255, 255, 255, 0.14)",
      "popup": "#1b1b28",
      "popup_text": "#e8e8f2",
      "popup_border": "#2d2d40",
      "popup_highlight": "rgba(255, 46, 99, 0.24)",
      "popup_highlight_text": "#ffffff",
      "sidebar": "#12121c",
      "sidebar_text": "#e8e8f2",
      "sidebar_border": "#23232f",
      "sidebar_highlight": "rgba(255, 46, 99, 0.24)",
      "sidebar_highlight_text": "#ffffff",
      "ntp_background": "#0f0f19",
      "ntp_text": "#e8e8f2"
    }
  }
}
